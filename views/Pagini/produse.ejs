<!DOCTYPE html>
<html lang="ro">

<head>
    <meta name="description" content="ArtParlor ofera picturi, sculpturi si arta pentru pasionati.">
    <meta name="keywords" content="artparlor, arta, picturi, sculpturi, galerie">
    <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
    <title>ArtParlor - Produse</title>
    <%- include("../fragmente/head") %>
        <script type="text/javascript" src=/resurse/js/produse.js></script>
        <script type="text/javascript" src=/resurse/js/produse-cos.js></script>

</head>

<body>


    <%- include("../fragmente/header") %>

        <main>
            <div class="container mt-4">
                <div class="row g-3 mb-4 align-items-center">
                    <div class="col-md-4">
                        <label class="form-label" for="inp-nume">Nume:</label>
                        <input type="text" id="inp-nume" class="form-control">
                    </div>

                    <div class="col-md-8">
                        <label class="form-label d-block">Greutate (grame):</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" id="i_rad1" name="gr_rad" value="0:499"
                                autocomplete="off">
                            <label class="btn btn-outline-primary" for="i_rad1">Ușor (sub 500g)</label>

                            <input type="radio" class="btn-check" id="i_rad2" name="gr_rad" value="500:2000"
                                autocomplete="off">
                            <label class="btn btn-outline-primary" for="i_rad2">Mediu (500-2000g)</label>

                            <input type="radio" class="btn-check" id="i_rad3" name="gr_rad" value="2001:10000"
                                autocomplete="off">
                            <label class="btn btn-outline-primary" for="i_rad3">Greu (>2000g)</label>

                            <input type="radio" class="btn-check" id="i_rad4" name="gr_rad" value="toate"
                                autocomplete="off" checked>
                            <label class="btn btn-outline-primary" for="i_rad4">Toate</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="inp-culoare">Culoare:</label>
                        <input list="id-culori" id="inp-culoare" class="form-control">
                        <datalist id="id-culori">
                            <% for(let c of (locals.culoriDinDb || [])) { %>
                                <option value="<%- c %>">
                                    <% } %>
                        </datalist>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label d-block">Materiale (are / nu are):</label>
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="btn-group" role="group">
                                <input type="checkbox" class="btn-check chk-material" id="chk-lemn" value="lemn"
                                    autocomplete="off">
                                <label class="btn btn-outline-secondary fw-bold" for="chk-lemn">Lemn</label>
                                <input type="radio" class="btn-check" name="rad_lemn" id="rad-lemn-are" value="are"
                                    autocomplete="off" checked>
                                <label class="btn btn-outline-primary" for="rad-lemn-are">are</label>
                                <input type="radio" class="btn-check" name="rad_lemn" id="rad-lemn-nu" value="nu are"
                                    autocomplete="off">
                                <label class="btn btn-outline-primary" for="rad-lemn-nu">nu</label>
                            </div>

                            <div class="btn-group" role="group">
                                <input type="checkbox" class="btn-check chk-material" id="chk-plastic" value="plastic"
                                    autocomplete="off">
                                <label class="btn btn-outline-secondary fw-bold" for="chk-plastic">Plastic</label>
                                <input type="radio" class="btn-check" name="rad_plastic" id="rad-plastic-are"
                                    value="are" autocomplete="off" checked>
                                <label class="btn btn-outline-primary" for="rad-plastic-are">are</label>
                                <input type="radio" class="btn-check" name="rad_plastic" id="rad-plastic-nu"
                                    value="nu are" autocomplete="off">
                                <label class="btn btn-outline-primary" for="rad-plastic-nu">nu</label>
                            </div>

                            <div class="btn-group" role="group">
                                <input type="checkbox" class="btn-check chk-material" id="chk-metal" value="metal"
                                    autocomplete="off">
                                <label class="btn btn-outline-secondary fw-bold" for="chk-metal">Metal</label>
                                <input type="radio" class="btn-check" name="rad_metal" id="rad-metal-are" value="are"
                                    autocomplete="off" checked>
                                <label class="btn btn-outline-primary" for="rad-metal-are">are</label>
                                <input type="radio" class="btn-check" name="rad_metal" id="rad-metal-nu" value="nu are"
                                    autocomplete="off">
                                <label class="btn btn-outline-primary" for="rad-metal-nu">nu</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-floating">
                            <textarea class="form-control" placeholder="Caută cuvinte în descriere..."
                                id="inp-descriere" style="height: 100px"></textarea>
                            <label for="inp-descriere">Caută cuvinte în descriere...</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" for="inp-tip">Tip produs (multiplu):</label>
                        <select id="inp-tip" class="form-select" multiple size="3">
                            <% for(let opt of (locals.optiuni_meniu || [])) { %>
                                <option value="<%- opt.unnest %>" selected><%- opt.unnest.charAt(0).toUpperCase() +
                                        opt.unnest.slice(1) %></option>
                                <% } %>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" id="inp-copii">
                            <label class="form-check-label" for="inp-copii">Sigur pt. copii</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" for="inp-pret">Preț minim: <span id="infoRange">(<%- locals.minPret ||
                                    0 %>)</span></label>
                        <input type="range" class="form-range" id="inp-pret" value="<%- locals.minPret || 0 %>"
                            min="<%- locals.minPret || 0 %>" max="<%- locals.maxPret || 150 %>">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label" for="inp-categorie">Select simplu:</label>
                        <select id="inp-categorie" class="form-select">
                            <option id="sel-toate" selected value="toate">Toate</option>
                            <% function formateazaCategorie(cat) { const dictionar={ 'pentru_incepatori'
                                : 'Pentru începători' , 'profesional' : 'Profesional' , 'hobby' : 'Hobby'
                                , 'pentru_copii' : 'Pentru copii' , 'editie_limitata' : 'Ediție limitată'
                                , 'set_complet' : 'Set complet' }; return dictionar[cat] || cat; } for (let opt of
                                locals.optiuni) { %>
                                <option value="<%- formateazaCategorie(opt.unnest).toLowerCase() %>"><%-
                                        formateazaCategorie(opt.unnest) %> </option>
                                <% } %>
                        </select>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <button class="btn btn-primary" id="filtrare"><i class="bi bi-funnel-fill"></i> <span
                            class="d-none d-md-inline">Filtrează</span></button>
                    <button class="btn btn-secondary" id="resetare"><i class="bi bi-x-circle-fill"></i> <span
                            class="d-none d-md-inline">Resetează</span></button>
                    <button class="btn btn-info text-white" id="calculare"><i class="bi bi-calculator-fill"></i> <span
                            class="d-none d-md-inline">Calculează</span></button>
                    <button class="btn btn-primary" id="sortCrescNume"><i class="bi bi-sort-up"></i> <span
                            class="d-none d-md-inline">Sortează crescător</span></button>
                    <button class="btn btn-primary" id="sortDescrescNume"><i class="bi bi-sort-down"></i> <span
                            class="d-none d-md-inline">Sortează descrescător</span></button>
                </div>
                <p id="p-suma" class="text-muted">Apăsați Alt+"c" pentru suma prețurilor produselor afișate.</p>
            </div>

            <section id="produse">

                <h2>Produse</h2>
                <h4 id="mesaj-nu-exista" style="display: none; text-align: center; color: red; margin: 40px 0;">Nu
                    există produse conform filtrării curente.</h4>
                <div class="grid-produse">
                    <% for( let prod of locals.produse) { %>
                        <article id="artc-<%-prod.id %>" class="produs <%- prod.categorie %>">
                            <h3 class="nume"><a href="/produs/<%-prod.id %>"><span class="val-nume"><%-
                                            prod.nume%></span></a></h3>
                            <div class="produs-cols" style="display: flex; gap: 20px;">
                                <div class="produs-col1" style="flex: 1;">
                                    <figure>
                                        <a href="/produs/<%-prod.id %>"><img
                                                src="/resurse/imagini/produse/<%- prod.imagine %>"
                                                style="width:150px;height:auto;" alt="[imagine <%- prod.nume %>]" /></a>
                                    </figure>
                                    <ul class="info-prod" style="list-style-type: none; padding: 0;">
                                        <li><span class="label-caracteristica">Preț:</span> <span class="val-pret"><%-
                                                    prod.pret%></span> RON</li>
                                        <li><span class="label-caracteristica">Greutate:</span> <span
                                                class="val-greutate"><%- prod.greutate%></span> g</li>
                                        <li><span class="label-caracteristica">Culoare:</span> <span
                                                class="val-culoare"><%- prod.culoare%></span></li>
                                        <li><span class="label-caracteristica">Materiale:</span> <span
                                                class="val-materiale"><%- prod.materiale%></span></li>
                                        <li><span class="label-caracteristica">Sigur pentru copii:</span> <span
                                                class="val-copii"><%- prod.sigur_pentru_copii ? 'Da' : 'Nu' %></span>
                                        </li>
                                        <% let d=new Date(prod.data_adaugare); let zile=['Duminică', 'Luni' , 'Marți'
                                            , 'Miercuri' , 'Joi' , 'Vineri' , 'Sâmbătă' ]; let
                                            luni=['Ianuarie', 'Februarie' , 'Martie' , 'Aprilie' , 'Mai' , 'Iunie'
                                            , 'Iulie' , 'August' , 'Septembrie' , 'Octombrie' , 'Noiembrie'
                                            , 'Decembrie' ]; let formatData=d.getDate() + ' ' + luni[d.getMonth()] + ' '
                                            + d.getFullYear() + ' [' + zile[d.getDay()] + ']' ; %>
                                            <li><span class="label-caracteristica">Data adăugare:</span> <time
                                                    class="val-data"><%- formatData %></time></li>
                                    </ul>
                                </div>
                                <div class="produs-col2" style="flex: 1;">
                                    <p class="categorie"><span class="label-caracteristica">Categorie:</span> <span
                                            class="val-categorie"><%- formateazaCategorie(prod.categorie)%></span></p>
                                    <p class="tip"><span class="label-caracteristica">Tip produs:</span> <span
                                            class="val-tip"><%- prod.tip_produs %></span></p>
                                    <p class="descriere-container"><span class="label-caracteristica">Descriere:</span>
                                        <span class="val-descriere"><%- prod.descriere %></span>
                                    </p>
                                    <label class="selecteaza-cos">
                                        Selectează:<br />
                                        <input type="checkbox" class="select-cos" value="<%-prod.id %>"
                                            autocomplete="off">
                                    </label>
                                </div>
                            </div>
                        </article>
                        <% }%>
                </div>
            </section>
        </main>

        <%- include("../fragmente/footer") %>
</body>

</html>