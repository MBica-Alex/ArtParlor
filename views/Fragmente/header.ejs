<header>
    <script src="/Resurse/JS/tema.js"></script>
    <h1><i class="fa-solid fa-palette"></i> ArtParlor</h1>
    <img src="/Resurse/Imagini/sigla.png" alt="sigla ArtParlor" style="width:150px;" />
    <input type="checkbox" id="burger-checkbox">
    <label for="burger-checkbox" id="burger-meniu">
        <div id="hamburger-icon">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </label>
    <nav id="meniu-top">
        <ul>
            <li><a href="javascript:void(0)"><i class="fa-solid fa-house"></i> <span class="nav-text">Acasă</span></a>
                <ul>
                    <li><a href="/index#welcome">Bine ați venit</a></li>
                    <li><a href="/index#promotii">Promoții</a></li>
                </ul>
            </li>
            <li><a href="javascript:void(0)"><i class="fa-solid fa-paintbrush"></i> <span
                        class="nav-text">Produse</span></a>
                <ul> 
                    <li><a href="/produse">Toate</a></li>
                    <% for(let opt of (locals.optiuni_meniu || [])) { %>
                        <li><a href="/produse?tip=<%- opt.unnest %>"><%- opt.unnest.charAt(0).toUpperCase() +
                                    opt.unnest.slice(1) %></a></li>
                        <% } %>
                            <li><a href="/galerie">Galerie Statică</a></li>
                </ul>
            </li>

            <li><a href="javascript:void(0)"><i class="fa-solid fa-user"></i> <span class="nav-text">Contul
