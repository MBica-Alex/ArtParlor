                <ul>
                    <li><a href="javascript:void(0)">Înregistrare</a></li>
                    <li><a href="javascript:void(0)">Log In</a></li>
                </ul>
            </li>
            <li><a href="/index#contact"><i class="fa-solid fa-envelope"></i> <span class="nav-text">Contact</span></a>
            </li>
        </ul>
    </nav>
    <div id="theme-selector-container">
        <select id="select-tema" class="form-select form-select-sm shadow-sm" aria-label="Selectează tema">
            <option value="light">Light</option>
            <option value="dark">Dark</option>
            <option value="nature">Nature</option>
        </select>
